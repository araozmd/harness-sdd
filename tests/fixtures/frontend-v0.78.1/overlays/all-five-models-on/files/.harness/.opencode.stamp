{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".harness/AGENTS.md"],
  "agent": {
    "orchestrator": { "mode": "primary",  "description": "The Leader: routes the next task, delegates. Never writes code.", "model": "fixture/reasoning", "prompt": "{file:./.harness/agents/orchestrator.md}" },
    "architect":    { "mode": "subagent", "description": "Spec Author: writes the 4-file spec (EARS).",                     "model": "fixture/reasoning", "prompt": "{file:./.harness/agents/architect.md}" },
    "builder":      { "mode": "subagent", "description": "Implementer: writes code from an approved spec.",                 "model": "fixture/standard", "prompt": "{file:./.harness/agents/builder.md}" },
    "builder-heavy":{ "mode": "subagent", "description": "Implementer at the escalation tier; same body as builder.",       "model": "fixture/reasoning", "prompt": "{file:./.harness/agents/builder-heavy.md}" },
    "reviewer":     { "mode": "subagent", "description": "Evaluator: verifies against the spec, runs tests.",               "model": "fixture/standard", "prompt": "{file:./.harness/agents/reviewer.md}" },
    "scout":        { "mode": "subagent", "description": "Read-only recon; writes findings to progress/.",                  "model": "fixture/cheap", "prompt": "{file:./.harness/agents/scout.md}" },
    "doc-critic":   { "mode": "subagent", "description": "Advisory doc review pass over planning docs + specs. Documents only, never code.", "model": "fixture/cheap", "prompt": "{file:./.harness/agents/doc-critic.md}" }
  }
}
