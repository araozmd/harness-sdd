# Per-run agent output is ephemeral; keep the folder + history, ignore run dirs.
progress/*/
!progress/.gitkeep
!progress/README.md
# Inbox briefs are durable seeds the Architect specs from — keep them tracked.
!progress/inbox/
!progress/inbox/**

# /sdd-pr-loop round cache (Codex review state fetched per round). The harness source
# runs from the repo root, where <HARNESS_DIR>/.pr-loop resolves to a root-level dir that
# the .harness/ ignore below does NOT cover — so ignore it explicitly. (Installed consumers
# get the equivalent entry in their seeded .harness/.gitignore from harness-install.sh.)
/.pr-loop/

# OpenCode parallel-batch concurrency marker (E31-F01). The shared sdd-fix-parallel skill's
# source-layout remediation tells a source-repo user to write `supported` to a root-level
# .opencode-parallel; the harness source runs from the repo root, where the marker resolves
# root-relative and the .harness/ ignore below does NOT cover it. Left untracked it makes
# tools/fix-worktree.sh primary_clean() abort, so the recovery would defeat its own batch.
# (Installed consumers get the equivalent entry in their seeded .harness/.gitignore.)
/.opencode-parallel

# Local isolated feature worktrees.
.worktrees/
.claude/worktrees/

# OS / editor
.DS_Store
.obsidian/workspace*
*.swp

# Never commit a self-install of the harness into its own source repo.
.harness/

# Telemetry is local-only runtime data, never committed. The harness source runs from
# the repo root, where <HARNESS_DIR>/telemetry.jsonl resolves to a root-level log that
# .harness/ above does NOT cover — so ignore it explicitly. (Consumers get a seeded
# .harness/.gitignore from harness-install.sh.)
/telemetry.jsonl

# Runtime board write lockfile (E15-F01). The documented source-layout invocation
# `python3 tools/tasks-lock.py set-status …` creates a zero-byte flock target at
# root-relative state/tasks.json.lock (never board data); the .harness/ ignore above
# does NOT cover this source-layout path, so ignore it explicitly. (Installed consumers
# get the equivalent entry in their seeded .harness/.gitignore from harness-install.sh.)
/state/tasks.json.lock

# Python bytecode cruft (e.g. from running tools/telemetry-report.py locally)
__pycache__/
*.pyc

# Local-only config for the harness, never committed.
.local/
.obsidian/

# Agent scratch files (namespaced by feature-id/role per agents/builder.md) — mutation
# runners, probe scripts, captured logs. Never repo content; tracked once inflated
# tools/change-size.sh's ADVISE tier during E30-F01 round 1 review purely because it was
# untracked-but-present, not because any of it was production code.
/scratchpad/
