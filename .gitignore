# Per-run agent output is ephemeral; keep the folder + history, ignore run dirs.
progress/*/
!progress/.gitkeep
!progress/README.md

# pr-loop / multi-cli-orchestrator local cache (Codex review state)
.mco-cache/

# OS / editor
.DS_Store
.obsidian/workspace*
*.swp

# Never commit a self-install of the harness into its own source repo.
.harness/
